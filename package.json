{
  "name": "figma-agent",
  "version": "1.0.0",
  "description": "AI Agent for Figma (Read and Write) without MCP bridge",
  "main": "dist/index.js",
  "bin": {
    "figma-agent": "dist/cli/index.js"
  },
  "scripts": {
    "build:plugin": "node build-plugin.js",
    "build:server": "esbuild src/index.ts src/cli/index.ts --bundle --platform=node --outdir=dist --format=cjs --sourcemap --external:express --external:ws --external:cors --external:dotenv",
    "build": "npm run build:plugin && npm run build:server",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "cli": "node dist/cli/index.js",
    "test": "vitest run"
  },
  "keywords": [
    "figma",
    "agent",
    "ai",
    "design",
    "figma-api",
    "figma-plugin",
    "no-mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.138.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
